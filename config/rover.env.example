# Rover environment configuration
# Copy to config/rover.env and edit as needed

# Arduino serial port
ARDUINO_PORT=/dev/ttyACM0
ARDUINO_BAUD=115200
ARDUINO_TIMEOUT=0.1
ARDUINO_WATCHDOG_MS=500

# Camera (CSI = true for Jetson CSI ribbon, false for USB webcam)
USE_CSI=true
CAMERA_WIDTH=640
CAMERA_HEIGHT=480
CAMERA_FPS=30
CAMERA_FLIP=0

# Motor control
MAX_SPEED=220
ACCEL_STEP=12
DEADZONE=0.05

# Server
HOST=0.0.0.0
PORT=8000

# Streaming
STREAM_QUALITY=75
STREAM_FPS_MAX=30

# SLAM / mapping
MAP_RESOLUTION=0.05
MAP_WIDTH_CELLS=400
MAP_HEIGHT_CELLS=400
MAPS_DIR=maps

# Safety
OBSTACLE_STOP_DIST=0.3
OBSTACLE_SLOW_DIST=0.6
